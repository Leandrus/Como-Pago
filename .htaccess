# ==============================================================================
# SEGURIDAD Y CONFIGURACIÓN DEL SERVIDOR WEB - ¿CÓMO PAGO EN VENEZUELA?
# ==============================================================================

# 1. Cabeceras de Seguridad HTTP Estándar
<IfModule mod_headers.c>
    # Content Security Policy (CSP)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api-dolar.leandrus.net; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"

    # Prevenir ataques de clickjacking
    Header set X-Frame-Options "DENY"

    # Forzar detección estricta de tipos MIME
    Header set X-Content-Type-Options "nosniff"

    # Política de Referrer
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restringir accesos a hardware y APIs sensibles del dispositivo
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # HTTP Strict Transport Security (HSTS)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Eliminar huellas del servidor
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# 2. Tipos MIME Estándar
<IfModule mod_mime.c>
    AddType application/manifest+json          .webmanifest .json
    AddType text/cache-manifest                 .appcache
    AddType image/svg+xml                       .svg .svgz
    AddType text/plain                          .txt
    AddType application/xml                     .xml
</IfModule>

# 3. Compresión GZIP / Brotli
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 4. Políticas de Caché de Recursos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML y Service Worker (Cero caché para que las actualizaciones se reflejen al instante)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 1 week"

    # Estilos y Scripts (Caché breve con revalidación)
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType text/javascript "access plus 1 hour"

    # Fuentes e Imágenes
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cabeceras de control de caché para forzar actualización en móviles
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# 5. Prohibir acceso a archivos ocultos (excepto .well-known)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>
